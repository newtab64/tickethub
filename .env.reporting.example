# Copy to .env.reporting. Do not commit real credentials.
DATABASE_URL=postgresql://tickethub:CHANGE_ME@postgres:5432/tickethub_dev
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
ED25519_PRIVATE_KEY=REPLACE_WITH_BASE64_PKCS8_DER_PRIVATE_KEY
# Configure these for the payment service in the same API process.
VNPAY_TMN_CODE=REPLACE_ME
VNPAY_HASH_SECRET=REPLACE_ME
# Report email delivery is disabled until the provider and frontend are configured.
ENABLE_REPORT_EMAIL_DELIVERY=false
ENABLE_REAL_EMAIL=false
EMAIL_WORKER_MODE=mock
REPORT_WEB_URL=https://your-frontend.example
EMAIL_FROM=TicketHub <reports@your-verified-domain.example>
# RESEND_API_KEY=

# Enable only after configuring a real sandbox/production merchant.
ENABLE_VNPAY_IPN_PROCESSING=false
ENABLE_VNPAY_REFUNDS=false
ENABLE_PAYMENT_EMAIL=false
# VNPAY_REFUND_IP=YOUR_MERCHANT_REGISTERED_IP
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
