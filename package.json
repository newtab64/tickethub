{
  "name": "tickethub-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @tickethub/api dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint \"apps/api/**/*.ts\" \"packages/shared/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @tickethub/api db:generate",
    "db:migrate": "pnpm --filter @tickethub/api db:migrate",
    "db:seed": "pnpm --filter @tickethub/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2"
  }
}
