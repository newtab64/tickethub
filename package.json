{
  "name": "tickethub-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @tickethub/api dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm --filter @tickethub/shared build && pnpm --filter @tickethub/api exec tsc --noEmit && pnpm --filter @tickethub/web exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "docs:check": "node scripts/audit-doc-parity.mjs",
    "db:generate": "pnpm --filter @tickethub/api db:generate",
    "db:migrate": "pnpm --filter @tickethub/api db:migrate",
    "db:seed": "pnpm --filter @tickethub/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
