# Server Configuration
NODE_ENV=development
PORT=4000

# Database & Cache
DATABASE_URL=postgresql://tickethub:tickethub_secret@localhost:5432/tickethub_dev
REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=tickethub-super-secret-development-jwt-key-2026-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Dynamic Ticket QR Signing (Ed25519)
ED25519_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIFXdummyed25519privatekeydevelopmentonly2026=

# VNPay Payment Gateway
VNPAY_TMN_CODE=TEST_TMN_CODE
VNPAY_HASH_SECRET=TEST_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return

# Email Service (Resend)
RESEND_API_KEY=re_test_dummy_key_12345
EMAIL_FROM=onboarding@resend.dev
TEST_EMAIL_TO=test@tickethub.vn

# AWS S3 / Cloudflare R2 Storage (Media Uploads)
S3_REGION=ap-southeast-1
S3_BUCKET=tickethub-media
S3_ACCESS_KEY_ID=test_s3_access_key
S3_SECRET_ACCESS_KEY=test_s3_secret_key
S3_PUBLIC_BASE_URL=https://media.tickethub.vn

# VNPay QueryDR / Refund (never put real credentials in tracked files)
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_API_TIMEOUT_MS=5000
# IP merchant đã đăng ký VNPay, dùng chung cho Refund và QueryDR; loopback chỉ để test cục bộ.
VNPAY_REFUND_IP=127.0.0.1
ENABLE_VNPAY_IPN_PROCESSING=false
ENABLE_VNPAY_REFUNDS=false
ENABLE_PAYMENT_EMAIL=false
