{
  "name": "@tickethub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "start:email-worker": "tsx src/contexts/notification/interface/email.worker.ts",
    "start:outbox-dispatcher": "tsx src/contexts/notification/interface/outbox.dispatcher.ts",
    "start:outbox-recovery": "tsx src/contexts/notification/interface/outbox-recovery.ts",
    "start:refund-processor": "tsx src/contexts/payment/interface/refund-processor.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-fastify": "^12.4.2",
    "@tickethub/shared": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.2",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
